# Test-mode secret only. The server rejects live keys.
PAYSTACK_SECRET_KEY=sk_test_replace_with_your_test_secret

# Public site URL used for canonical SEO metadata and Paystack's return URL.
APP_URL=http://localhost:3000

# Telegram Bot Operations Concierge
# 1. Obtain bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# 2. Obtain your chat or staff group ID from @userinfobot or @RawDataBot
TELEGRAM_CHAT_ID=your_chat_or_group_id_here
# 3. Telegram user IDs allowed to perform admin actions (comma-separated; required for group chats)
TELEGRAM_ADMIN_USER_IDS=your_telegram_user_id_here
# 4. Optional secret token for securing the incoming Telegram webhook
TELEGRAM_WEBHOOK_SECRET=your_random_secret_token_here

# Brevo Transactional Email Service
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_verified_sender_email@domain.com
BREVO_SENDER_NAME=Markson Hotels & Resorts

# Cloudinary media uploads (optional; local storage is used when unset)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
