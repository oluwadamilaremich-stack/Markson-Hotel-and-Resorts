# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
/out/

# production
build/
dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!**/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# design references pulled from Figma (large, regenerated on demand)
/designs/
/.qodo/

# telegram bot JSON data store (seeded at runtime)
**/data/rooms.json
**/data/posts.json
**/data/bookings.json

# one-off email tests can send real messages through Brevo
apps/frontend/scripts/test-cid.mjs
apps/frontend/scripts/test-email.mjs
apps/frontend/scripts/test-luxury-email.mjs
apps/frontend/scripts/test-website-aligned-email.mjs

# uploaded media from Telegram
**/public/images/uploads/
